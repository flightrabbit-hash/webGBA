{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "webGBA",
  "mainBinaryName": "webgba",
  "version": "0.2.0",
  "identifier": "com.flightrabbit.webgba",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node src-bundle/build-dist.cjs",
    "beforeDevCommand": "node src-bundle/build-dist.cjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "publisher": "flightrabbit",
    "copyright": "Copyright © 2026 flightrabbit",
    "license": "MIT",
    "shortDescription": "GBA 실행기",
    "longDescription": "mGBA 코어와 웹 빌드(.wgba · .wasm)를 여는 GBA 실행기",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES": "THIRD_PARTY_NOTICES",
      "../src-bundle/bin/": "bin/"
    }
  }
}
