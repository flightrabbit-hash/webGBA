{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flightrabbit-hash/webGBA/blob/main/docs/wgba/wgba-manifest.schema.json",
  "title": ".wgba manifest (wgba 1)",
  "type": "object",
  "required": ["wgba", "id", "version", "name", "runtime"],
  "properties": {
    "wgba": { "const": 1 },
    "id": { "type": "string", "maxLength": 64, "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
    "name": { "$ref": "#/$defs/text48", "description": "Game name (library, start screen, window title). A string is used for every language. An object has one entry per language: 1 \"en\" English, 2 \"ko\" Korean, 3 \"ja\" Japanese (other language codes allowed). Hosts show the screen language's entry, then \"en\" → \"ko\" → \"ja\", then other entries in the order written; empty entries count as missing" },
    "shortName": { "$ref": "#/$defs/text16", "description": "Name on the cartridge spine (and on the label when there is no label picture). Same entries and order as name; missing or empty → name" },
    "description": { "$ref": "#/$defs/text500" },
    "runtime": { "enum": ["webapi", "script"] },
    "author": { "type": "string", "maxLength": 64 },
    "license": { "type": "string", "maxLength": 64 },
    "homepage": { "type": "string", "maxLength": 200, "pattern": "^https://" },
    "contact": { "type": "string", "maxLength": 100 },
    "build": { "type": "string", "maxLength": 64 },
    "needs": { "type": "array", "uniqueItems": true, "items": { "enum": ["pointer", "net", "keyboard", "state"] } },
    "group": { "enum": ["emu", "arcade", "mobile"], "description": "Library group (README 13.3). Mobile games (.wmba, .wapk) use \"mobile\"" },
    "category": { "type": "string", "pattern": "^[\\x20-\\x7e]{1,24}$", "description": "Category inside the group, e.g. \"WIPI-KTF\", \"Android\", \"CPS1\", \"GBA\"" },
    "mobile": {
      "type": "object",
      "description": "Feature-phone game (.wmba, README chapter 13) or Android app (.wapk, platform \"Android\", README chapter 14). Required for both; the rom chunk holds the WMFS app file bundle",
      "required": ["platform"],
      "properties": {
        "platform": { "enum": ["WIPI-KTF", "WIPI-SKT", "WIPI-LGT", "SKVM", "J2ME", "Android"] },
        "aid": { "type": "string", "maxLength": 64 },
        "pid": { "type": "string", "maxLength": 64 },
        "mclass": { "type": "string", "maxLength": 64 },
        "vendor": { "type": "string", "maxLength": 64 },
        "appVersion": { "type": "string", "maxLength": 64 },
        "package": { "type": "string", "maxLength": 128, "pattern": "^[A-Za-z][\\w]*(\\.[A-Za-z_][\\w]*)+$", "description": "Android package name (.wapk)" },
        "versionCode": { "type": "integer", "minimum": 0, "description": "Android versionCode (.wapk)" },
        "minSdk": { "type": "integer", "minimum": 1, "maximum": 99, "description": "Android minSdkVersion (.wapk)" },
        "orientation": { "enum": ["landscape", "portrait", "any"], "description": "Screen orientation of an Android app (.wapk, README 14.2). Default any" },
        "input": { "enum": ["touch", "keys", "both"], "description": "Input of an Android app (.wapk, README 14.2). Default touch" },
        "keys": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["up", "down", "left", "right", "ok", "soft1", "soft2", "clear", "num1", "num2", "num3", "num4", "num5", "num6", "num7", "num8", "num9", "star", "num0", "hash", "call", "end", "back", "menu", "a", "b", "c", "d", "l", "r", "l2", "r2", "start", "select"] },
          "description": "Keys the game uses (README 13.4, 14.2). On .wmba the touch screen hides phone keys not listed; without it every defined key is shown. back, menu and the gamepad roles are for .wapk only"
        }
      }
    },
    "screen": {
      "type": "object",
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 1024, "default": 240 },
        "height": { "type": "integer", "minimum": 1, "maximum": 1024, "default": 160 },
        "fps": { "type": "number", "exclusiveMinimum": 0, "maximum": 240, "default": 59.7275 },
        "scale": { "enum": ["fit", "integer"], "default": "fit" }
      }
    },
    "display": {
      "type": "object",
      "properties": {
        "aspect": { "type": "string", "pattern": "^[1-9][0-9]{0,3}:[1-9][0-9]{0,3}$", "description": "W:H, each 1-1024, ratio between 1:4 and 4:1" }
      }
    },
    "audio": { "type": "object", "properties": { "use": { "type": "boolean", "default": true } } },
    "save": {
      "type": "object",
      "properties": {
        "kind": { "enum": ["flash", "storage", "localStorage", "files", "none"] },
        "maxSize": { "type": "integer", "minimum": 1, "maximum": 16777216, "default": 1048576 },
        "files": { "type": "array", "maxItems": 8, "items": { "type": "string", "pattern": "^/[^\\0]{1,200}$" } }
      }
    },
    "state": { "type": "object", "properties": { "use": { "type": "boolean" } } },
    "pointer": { "type": "object", "properties": { "use": { "type": "boolean", "default": false } } },
    "input": {
      "type": "object",
      "properties": {
        "preset": { "enum": ["gba", "none"] },
        "keyboard": { "enum": ["mapped", "raw"], "default": "mapped" },
        "dpad": { "enum": ["latest", "opposite", "both"] },
        "buttons": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/button" } },
        "rs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["buttons"],
            "properties": {
              "buttons": { "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,16}$" } },
              "hold": { "type": "integer", "minimum": 1, "maximum": 600, "default": 3 },
              "gap": { "type": "integer", "minimum": 0, "maximum": 600, "default": 3 }
            }
          }
        }
      }
    },
    "cart": {
      "type": "object",
      "properties": {
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "label": {
          "type": "object",
          "required": ["chunk", "format", "width", "height"],
          "properties": {
            "chunk": { "const": "cart.label" },
            "format": { "$ref": "#/$defs/imageFormat" },
            "width": { "enum": [48, 96, 144, 192] },
            "height": { "enum": [32, 64, 96, 128] }
          }
        },
        "front": {
          "type": "object",
          "required": ["chunk", "format", "width", "height"],
          "properties": {
            "chunk": { "const": "cart.front" },
            "format": { "$ref": "#/$defs/imageFormat" },
            "width": { "enum": [54, 108, 162, 216] },
            "height": { "enum": [44, 88, 132, 176] },
            "labelAt": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 0, "maximum": 216 } }
          }
        },
        "spine": {
          "type": "object",
          "required": ["chunk", "format", "width", "height"],
          "properties": {
            "chunk": { "const": "cart.spine" },
            "format": { "$ref": "#/$defs/imageFormat" },
            "width": { "enum": [18, 36, 54, 72] },
            "height": { "enum": [46, 92, 138, 184] },
            "textArea": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "integer", "minimum": 0, "maximum": 184 } }
          }
        }
      }
    },
    "rom": {
      "type": "object",
      "properties": {
        "required": { "type": "boolean", "default": true },
        "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "hint": { "type": "string", "maxLength": 64 }
      }
    },
    "entry": {
      "type": "object",
      "properties": {
        "style": { "enum": ["module", "emscripten"] },
        "js": { "const": "js", "default": "js" },
        "args": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 200 } }
      }
    },
    "files": { "type": "object", "maxProperties": 64, "additionalProperties": { "type": "string", "pattern": "^(data\\.[a-z0-9._-]{1,27}|rom)$" } },
    "update": {
      "type": "object",
      "description": "Online updates (README chapter 12): the host checks the signed version file once per app start and applies delta patches only when the player presses Update",
      "required": ["feed", "key"],
      "properties": {
        "feed": { "type": "string", "maxLength": 512, "pattern": "^https://[^\\s/]+/", "description": "Version file (latest.json) address, https only" },
        "key": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}[AEIMQUYcgkosw048]=$", "description": "ECDSA P-256 public key: the uncompressed 65-byte point (04 || X || Y) in standard base64" }
      }
    },
    "multiplayer": {
      "type": "object",
      "required": ["protocol"],
      "properties": {
        "protocol": { "type": "integer", "minimum": 1, "description": "멀티플레이 규약 번호(현재 1). 호스트가 아는 번호보다 크면 호스트는 멀티플레이만 끄고 게임은 실행(README 7.2)" },
        "players": { "type": "object", "properties": { "min": { "type": "integer", "minimum": 2, "maximum": 8 }, "max": { "type": "integer", "minimum": 2, "maximum": 8 } } },
        "purposes": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" },
              "name": { "$ref": "#/$defs/text48" },
              "players": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 2, "maximum": 8 } }
            }
          }
        },
        "compat": { "type": "string", "maxLength": 64 },
        "sync": { "enum": ["messages", "inputs"], "default": "messages" },
        "inputDelay": { "type": "integer", "minimum": 1, "maximum": 10, "default": 3 },
        "join": { "enum": ["anytime"], "description": "anytime = 중간 참가 게임: 멀티플레이 창을 자동으로 열지 않고 시간 초과 없음, 방장이 방을 만들거나 갱신한 뒤 2분 30초 동안 참가를 받음(README 7.12)" },
        "rejoin": { "type": "boolean", "default": false, "description": "true = 다시 들어오기: 연결이 끊긴 유저의 자리를 세션 끝까지 보관하고 같은 자리로 돌아오게 함(방 코드 세션만, README 7.10)" },
        "iceServers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "description": "게임별 연결 서버(README 7.11). 지정하면 webGBA 기본 STUN·TURN 대신 이 목록만 사용. 서버 주소는 모두 합쳐 4개까지. turn:·turns: 는 username·credential 또는 credentialUrl 이 필요하고, 고정 접속 정보는 경고(credentialUrl 권장)",
          "items": {
            "type": "object",
            "required": ["urls"],
            "properties": {
              "urls": {
                "oneOf": [
                  { "$ref": "#/$defs/iceUrl" },
                  { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/iceUrl" } }
                ]
              },
              "username": { "type": "string", "minLength": 1, "maxLength": 512 },
              "credential": { "type": "string", "minLength": 1, "maxLength": 512 },
              "credentialUrl": { "type": "string", "maxLength": 512, "pattern": "^https://", "description": "연결할 때 호스트가 GET → { username, credential, ttl }(turn:·turns: 서버만, CORS 로 https://webgba.vercel.app·http://ui.localhost 허용)" }
            }
          }
        },
        "board": {
          "type": "object",
          "required": ["columns"],
          "properties": {
            "columns": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": {
                "type": "object",
                "required": ["id", "type", "name"],
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-z0-9-]{1,16}$" },
                  "type": { "enum": ["bar", "number", "rank", "status"] },
                  "name": { "$ref": "#/$defs/text12" },
                  "max": { "type": "integer", "minimum": 1, "maximum": 65535 },
                  "tone": { "enum": ["hp", "accent"], "default": "accent" },
                  "prefix": { "$ref": "#/$defs/text4" },
                  "suffix": { "$ref": "#/$defs/text4" },
                  "labels": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 15,
                    "items": {
                      "type": "object",
                      "required": ["name"],
                      "properties": {
                        "name": { "$ref": "#/$defs/text8" },
                        "tone": { "enum": ["normal", "good", "warn", "bad", "dim"], "default": "normal" },
                        "dimRow": { "type": "boolean", "default": false }
                      }
                    }
                  }
                },
                "allOf": [
                  { "if": { "properties": { "type": { "const": "bar" } } }, "then": { "required": ["max"] } },
                  { "if": { "properties": { "type": { "const": "status" } } }, "then": { "required": ["labels"] } }
                ]
              }
            },
            "names": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/text16" } },
            "captions": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/text24" } },
            "mark": { "$ref": "#/$defs/text8" },
            "scope": { "enum": ["all", "self"], "default": "all" },
            "sort": { "type": "object", "required": ["column"], "properties": { "column": { "type": "string", "pattern": "^[a-z0-9-]{1,16}$" }, "order": { "enum": ["desc", "asc"], "default": "desc" } } }
          }
        }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "runtime": { "const": "script" } } }, "then": { "required": ["entry"] } }
  ],
  "$defs": {
    "imageFormat": { "enum": ["png", "webp"] },
    "iceUrl": { "type": "string", "maxLength": 256, "pattern": "^([Ss][Tt][Uu][Nn]|[Tt][Uu][Rr][Nn][Ss]?):(\\[[0-9A-Fa-f:.]+\\]|[A-Za-z0-9.-]+)(:[0-9]{1,5})?(\\?transport=(udp|tcp))?$" },
    "text4": { "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 4 }, { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 4 } }] },
    "text8": { "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 8 }, { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 8 } }] },
    "text12": { "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 12 }, { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 12 } }] },
    "text24": { "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 24 }, { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 24 } }] },
    "text16": { "oneOf": [{ "type": "string", "maxLength": 16 }, { "type": "object", "minProperties": 1, "properties": { "en": { "type": "string", "maxLength": 16, "description": "English" }, "ko": { "type": "string", "maxLength": 16, "description": "Korean" }, "ja": { "type": "string", "maxLength": 16, "description": "Japanese" } }, "additionalProperties": { "type": "string", "maxLength": 16 } }] },
    "text48": { "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 48 }, { "type": "object", "minProperties": 1, "properties": { "en": { "type": "string", "minLength": 1, "maxLength": 48, "description": "English" }, "ko": { "type": "string", "minLength": 1, "maxLength": 48, "description": "Korean" }, "ja": { "type": "string", "minLength": 1, "maxLength": 48, "description": "Japanese" } }, "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 48 } }] },
    "text500": { "oneOf": [{ "type": "string", "maxLength": 500 }, { "type": "object", "additionalProperties": { "type": "string", "maxLength": 500 } }] },
    "button": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,16}$" },
        "role": { "enum": ["up", "down", "left", "right", "a", "b", "c", "d", "l", "r", "l2", "r2", "start", "select", "extra", "ok", "soft1", "soft2", "clear", "num1", "num2", "num3", "num4", "num5", "num6", "num7", "num8", "num9", "star", "num0", "hash", "call", "end", "back", "menu"] },
        "label": { "oneOf": [{ "type": "string", "maxLength": 8 }, { "type": "object", "additionalProperties": { "type": "string", "maxLength": 8 } }] },
        "bit": { "type": "integer", "minimum": 0, "maximum": 31 },
        "code": { "type": "string", "pattern": "^[A-Za-z0-9]{1,24}$" },
        "keys": { "type": "array", "maxItems": 4, "items": { "type": "string", "pattern": "^[A-Za-z0-9]{1,24}$" } },
        "pad": { "type": "array", "maxItems": 4, "items": { "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 31 }, { "type": "string", "pattern": "^[+-]?axis[0-9]$" }] } },
        "touch": { "enum": ["auto", "hide"], "default": "auto" }
      }
    }
  }
}
